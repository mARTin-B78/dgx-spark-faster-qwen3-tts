+def _merge_instruct(voice_cfg: dict, req_instruct: Optional[str]) -> Optional[str]:
+    """Combine a voice's identity instruct with a per-request delivery direction.
+
+    A voice's instruct in voices.json describes WHO is speaking; an instruct
+    sent with the request describes HOW this one line is delivered. Replacing
+    the former with the latter would re-roll the character from a few words of
+    direction, so combine them, identity first — the same rule the VoiceDesign
+    server applies.
+
+    Instructions are only followed reliably in ICL mode. The .pt prompts written
+    by extract_embeddings.py are full ICL prompts (ref codec tokens + ref_text),
+    not x-vector-only, so this path qualifies.
+    """
+    base = str(voice_cfg.get("instruct") or "").strip()
+    line = str(req_instruct or "").strip()
+    if base and line and line != base:
+        return f"{base} {line}"
+    return line or base or None
+
 
