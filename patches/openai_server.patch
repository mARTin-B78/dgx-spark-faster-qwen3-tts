+def _seed_rng(seed: int) -> None:
+    """Seed PyTorch CPU and CUDA RNGs for reproducible sampling."""
+    torch.manual_seed(seed)
+    if torch.cuda.is_available():
+        torch.cuda.manual_seed_all(seed)
+
