+# ---------------------------------------------------------------------------
+# Text chunking for long input
+#
+# A single generate call is capped at MAX_SEQ_LEN codec tokens (the CUDA
+# graph's static cache size). Rather than raising that cache to cover the
+# longest text anyone might send — which burns VRAM permanently for every
+# request — long input is split into paragraph/sentence-sized segments that
+# each fit comfortably under the cap, generated back-to-back, and stitched
+# into one continuous stream/file.
+# ---------------------------------------------------------------------------
+
+_CODEC_HZ = 12          # talker codec frame rate (generated audio tokens/sec)
+_CHARS_PER_SEC = 15.0   # conservative estimate of spoken characters/sec
+_SEQ_LEN_SAFETY = 0.6   # stay well under the hard cap to leave room for slower speech
+_SENTENCE_SPLIT_RE = re.compile(r"(?<=[.!?])\s+")
+
+
+def _max_chars_per_segment() -> int:
+    budget_seconds = (MAX_SEQ_LEN * _SEQ_LEN_SAFETY) / _CODEC_HZ
+    return max(200, int(budget_seconds * _CHARS_PER_SEC))
+
+
+def _split_text_for_generation(text: str, max_chars: int) -> list:
+    """Split text into segments that each fit under max_chars.
+
+    Splits on paragraph breaks first (kept as separate segments so natural
+    pauses land there), then falls back to sentence boundaries for any
+    paragraph that alone exceeds the budget.
+    """
+    paragraphs = [p.strip() for p in re.split(r"\n\s*\n", text) if p.strip()]
+    if not paragraphs:
+        return [text]
+
+    segments = []
+    for para in paragraphs:
+        if len(para) <= max_chars:
+            segments.append(para)
+            continue
+        buf = ""
+        for sent in _SENTENCE_SPLIT_RE.split(para):
+            candidate = f"{buf} {sent}".strip() if buf else sent
+            if len(candidate) > max_chars and buf:
+                segments.append(buf)
+                buf = sent
+            else:
+                buf = candidate
+        if buf:
+            segments.append(buf)
+    return segments or [text]
 
 
